# Base URL of the Kern API (core service / Caddy). Empty = same origin (dev proxy / production Caddy).
PUBLIC_API_URL=

# WebSocket URL of the realtime gateway. Empty = wss://<same origin>/ws (dev proxy / Caddy).
PUBLIC_WS_URL=

# Run the app against an in-memory fake API with demo data — no backend needed.
# pnpm dev:mock sets this for you.
PUBLIC_API_MOCK=

# Comma-separated social sign-in providers to offer (must also be configured in core),
# e.g. google,github,microsoft
PUBLIC_AUTH_PROVIDERS=

# Instance name shown on auth screens.
PUBLIC_INSTANCE_NAME=Kern

# This instance's terms of service and privacy policy, linked from the sign-up screen so the
# person creating an account can read what they are agreeing to. Full https:// addresses.
# Leave either one empty and its link is not drawn — an instance with nothing published says
# nothing rather than pointing at a page that does not exist.
PUBLIC_TERMS_URL=
PUBLIC_PRIVACY_URL=
