{
  "name": "@kernhq/app",
  "version": "0.1.0",
  "private": true,
  "description": "Kern web app \u2014 SvelteKit PWA shell hosting every module's client",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev --port 5173",
    "dev:mock": "PUBLIC_API_MOCK=1 vite dev --port 5173",
    "build": "pnpm i18n && vite build",
    "preview": "vite preview --port 5173",
    "start": "node build",
    "lint": "biome check . && node scripts/check-icons.mjs && node scripts/check-i18n.mjs && node scripts/check-widgets.mjs",
    "i18n:missing": "node scripts/i18n.mjs missing",
    "i18n:fill": "node scripts/i18n.mjs fill",
    "i18n:new": "node scripts/i18n.mjs new",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "typecheck": "pnpm i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "icons": "node scripts/gen-icons.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "check:widgets": "node scripts/check-widgets.mjs"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.1",
    "@internationalized/date": "^3.12.0",
    "@kernhq/contracts": "^0.5.0",
    "@kernhq/kernel": "^0.6.0",
    "@kernhq/module-billing": "^0.2.0",
    "@kernhq/module-chat": "^0.3.1",
    "@kernhq/module-mail": "^0.2.2",
    "@kernhq/module-quire": "^0.4.1",
    "@kernhq/module-tracker": "^0.9.2",
    "@kernhq/sdk": "^0.1.1",
    "@kernhq/ui": "^0.6.0",
    "@lucide/svelte": "^1.33.0",
    "@tanstack/svelte-query": "^6.1.0",
    "better-auth": "^1.7.1",
    "svelte-dnd-action": "^0.9.64"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@inlang/paraglide-js": "^2.24.0",
    "@playwright/test": "^1.62.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.0.0",
    "@vite-pwa/sveltekit": "^1.1.0",
    "sharp": "^0.34.0",
    "svelte": "^5.56.0",
    "svelte-check": "^4.7.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.0"
  }
}
